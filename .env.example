
GEMINI_API_KEY="MY_GEMINI_API_KEY"

APP_URL="MY_APP_URL"

# OPENFDA_API_KEY: Optional API key for OpenFDA to increase rate limits.
OPENFDA_API_KEY=""

# Backend API URL - Required for production deployment
# Local development: uses /api (proxied by Express server)
# Production: set to your deployed backend URL (e.g., https://your-backend.com)
VITE_API_URL=""

# CORS Configuration (Backend only)
# Comma-separated list of allowed origins, or * for all
# Example: https://medguide.vercel.app,https://medguide.netlify.app
ALLOWED_ORIGINS="*"

# JWT Secret (Backend only) - Generate a secure random string
JWT_SECRET="your-secure-jwt-secret-key-here"
